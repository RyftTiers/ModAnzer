<Project Sdk="Microsoft.NET.Sdk">

  <!-- ModAnzer.exe: a small Windows app (.NET Framework 4.8, built into Windows 10/11)
       that runs the ModAnzer script with a RyftTiers-style interface. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ModAnzer</AssemblyName>
    <RootNamespace>ModAnzer</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <ApplicationIcon>..\ModAnzer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>ModAnzer</Product>
    <Company>RyftTiers</Company>
    <Description>ModAnzer - Minecraft screenshare scanner (read-only). github.com/RyftTiers/ModAnzer</Description>
    <Copyright>napatc1</Copyright>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\ModAnzer.ps1" LogicalName="ModAnzer.ps1" />
    <EmbeddedResource Include="..\ModAnzer.ico" LogicalName="ModAnzer.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- PowerShell 5.1 ships with Windows; reference the copy in the GAC and don't bundle it. -->
    <Reference Include="System.Management.Automation">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\System.Management.Automation\v4.0_3.0.0.0__31bf3856ad364e35\System.Management.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
